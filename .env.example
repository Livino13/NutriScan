# Gemini API key for food analysis (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here

# Optional: override the Gemini model (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optional: global API rate limiting via Upstash Redis
# (Vercel Marketplace → Upstash Redis; without these, per-instance memory limits apply)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: production error tracking via Sentry (client, VITE_ prefix required)
# VITE_SENTRY_DSN=

# Cloud database + Google OAuth via Firebase (Firestore).
# 1. Create a project at https://console.firebase.google.com
# 2. Enable Authentication → Sign-in method → Google
# 3. Enable Firestore Database (production mode) with rules:
#      match /users/{uid} {
#        allow read, write: if request.auth != null && request.auth.uid == uid;
#      }
# 4. Copy your web app config values below.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
